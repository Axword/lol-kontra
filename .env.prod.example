# Copy to .env.prod (ignored by Git), then fill the empty values.
# Keep this separate from the development .env file.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=worlds_xi
POSTGRES_USER=worlds_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=worlds_app
POSTGRES_APP_PASSWORD=
# Empty origins are correct when the browser and API use the same HTTPS host.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
DAILY_TIMEZONE=Europe/Warsaw
HTTP_PORT=8080
