FROM postgres:16-alpine
COPY init-runtime-role.sh /docker-entrypoint-initdb.d/10-runtime-role.sh
COPY backup.sh /opt/backup.sh
RUN sed -i 's/\r$//' /docker-entrypoint-initdb.d/10-runtime-role.sh \
    && sed -i 's/\r$//' /opt/backup.sh \
    && chmod 0755 /docker-entrypoint-initdb.d/10-runtime-role.sh /opt/backup.sh
