{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size 10MB
	}
	@django path /api /api/* /admin /admin/* /healthz /healthz/
	handle @django {
		reverse_proxy api:8000 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	handle {
		reverse_proxy frontend:3000
	}
}
