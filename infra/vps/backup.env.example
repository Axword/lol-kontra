# Root-only /etc/words-v/backup.env. Values are literal, without shell expansion.
RESTIC_REPOSITORY=s3:https://s3.example.com/backup-bucket/words-v
RESTIC_PASSWORD_FILE=/etc/words-v/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For SFTP use RESTIC_REPOSITORY=sftp:backup@another-host:/backups/words-v
# and configure a dedicated SSH key and verified known_hosts on the VPS.
