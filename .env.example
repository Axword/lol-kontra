# Local development example only. Never use these passwords/secrets in production.
# Production: use a separate private env file with docker-compose.prod.yml alone.
# Set DEBUG=false, a random >=50-character SECRET_KEY, explicit public hosts,
# HTTPS-only CORS/CSRF origins (or empty for same-origin), unique >=16-character
# owner/runtime DB passwords, and a separate POSTGRES_APP_USER.
# Production Nginx listens on 127.0.0.1:HTTP_PORT behind an external HTTPS proxy
# which preserves Host and overwrites X-Forwarded-Proto. It is not a TLS server.

# === Django ===
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,backend
DJANGO_SETTINGS_MODULE=config.settings
# Enable only if a trusted ingress overwrites the proxy header; prod compose does.
DJANGO_TRUST_PROXY_HEADERS=false

# === Database ===
POSTGRES_DB=lolroster
POSTGRES_USER=lolroster
POSTGRES_PASSWORD=lolroster
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://lolroster:lolroster@db:5432/lolroster
# Optional Neon connections: leave commented for local PostgreSQL.
# An explicitly empty DATABASE_RUNTIME_URL is rejected by the backend.
# DATABASE_URL is the pooled connection generated by the Neon CLI; keep it intact.
# API/Celery prefer DATABASE_RUNTIME_URL: a separate restricted application role.
# DATABASE_RUNTIME_URL=
# bootstrap_database uses the direct owner URL for migrations/session locks and
# restores the runtime connection afterward. Never use the transaction pooler here.
# DATABASE_URL_UNPOOLED=
# Keep both URLs on the same Neon branch/database, preserve provider TLS options,
# and keep all DATABASE_* values out of NEXT_PUBLIC_* and browser bundles.
# Production compose uses POSTGRES_* fields directly, not DATABASE_URL; passwords
# therefore need no URI escaping. For managed DATABASE_URL percent-encode them and
# keep provider TLS options, e.g. sslmode=verify-full&sslrootcert=/path/to/ca.pem.
# These roles are created only on the first start of a NEW prod_pgdata volume.
# POSTGRES_APP_USER=roster_app
# POSTGRES_APP_PASSWORD=use-a-separate-production-password

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === API ===
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost
HTTP_PORT=8080

# === Auth OAuth (wypełnij) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# === Scoring (nadpisywalne) ===
SCORING_COMMON=10
SCORING_RARE=25
SCORING_EPIC=60
SCORING_LEGENDARY=120
SCORING_DIAMOND_BONUS=50

# === Daily ===
DAILY_TIMEZONE=Europe/Warsaw
DAILY_PUBLISH_HOUR=0
DAILY_REVEAL_MODE=after_close

# === Frontend ===
NEXTAUTH_SECRET=change-me-nextauth
NEXTAUTH_URL=http://localhost:3000

# === Sentry ===
SENTRY_DSN=
